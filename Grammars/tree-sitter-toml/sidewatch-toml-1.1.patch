From 70d44bb5b5dba05009357d5193b8527a6dd8e8dd Mon Sep 17 00:00:00 2001
From: Sidewatch <noreply@example.com>
Date: Tue, 6 Oct 2026 16:36:32 +0700
Subject: [PATCH] TOML 1.1: \e and \xHH escapes, times without seconds

"\e", "\x41", 07:32 and 1979-05-27T07:32Z are valid TOML 1.1 and produced ERROR nodes.
---
 grammar.js               |  6 ++++--
 test/corpus/toml-1.1.txt | 27 +++++++++++++++++++++++++++
 2 files changed, 31 insertions(+), 2 deletions(-)
 create mode 100644 test/corpus/toml-1.1.txt

diff --git a/grammar.js b/grammar.js
index 7b77558..7c9ef6b 100644
--- a/grammar.js
+++ b/grammar.js
@@ -13,7 +13,8 @@ const float_exponent_part = seq(/[eE]/, decimal_integer_in_float_exponent_part);
 
 const rfc3339_date = /([0-9]+)-(0[1-9]|1[012])-(0[1-9]|[12][0-9]|3[01])/;
 const rfc3339_delimiter = /[ tT]/;
-const rfc3339_time = /([01][0-9]|2[0-3]):([0-5][0-9]):([0-5][0-9]|60)([.][0-9]+)?/;
+// TOML 1.1: the seconds are optional (`07:32`).
+const rfc3339_time = /([01][0-9]|2[0-3]):([0-5][0-9])(:([0-5][0-9]|60)([.][0-9]+)?)?/;
 const rfc3339_offset = /([zZ])|([+-]([01][0-9]|2[0-3]):[0-5][0-9])/;
 
 module.exports = grammar({
@@ -118,8 +119,9 @@ module.exports = grammar({
         ),
         $._multiline_basic_string_end,
       ),
+    // TOML 1.1 adds `\e` (escape) and `\xHH`.
     escape_sequence: $ =>
-      token.immediate(/\\([btnfr"\\]|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8})/),
+      token.immediate(/\\([btnfre"\\]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8})/),
     _escape_line_ending: $ => token.immediate(seq(/\\/, newline)),
     _literal_string: $ =>
       seq(
diff --git a/test/corpus/toml-1.1.txt b/test/corpus/toml-1.1.txt
new file mode 100644
index 0000000..6af2a55
--- /dev/null
+++ b/test/corpus/toml-1.1.txt
@@ -0,0 +1,27 @@
+================================================================================
+TOML 1.1: new escapes and times without seconds
+================================================================================
+
+escape_e = "escape \e and hex \x41\x7a"
+local_time_short = 07:32
+local_datetime_short = 1979-05-27T07:32
+offset_datetime_short = 1979-05-27T07:32Z
+
+--------------------------------------------------------------------------------
+
+(document
+  (pair
+    (bare_key)
+    (string
+      (escape_sequence)
+      (escape_sequence)
+      (escape_sequence)))
+  (pair
+    (bare_key)
+    (local_time))
+  (pair
+    (bare_key)
+    (local_date_time))
+  (pair
+    (bare_key)
+    (offset_date_time)))
-- 
2.56.0


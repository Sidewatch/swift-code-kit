From 3298b6ef112780aebd99769a284966d2e7f45732 Mon Sep 17 00:00:00 2001
From: David Michael <22668877+arraypress@users.noreply.github.com>
Date: Fri, 2 Oct 2026 18:11:51 +0700
Subject: [PATCH] Parse C++23 and C++26 syntax: if consteval, contracts, pack
 indexing, and more
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- `if consteval` / `if !consteval` (C++23, as in #362)
- Contracts: `pre(…)`, `post(r: …)` on function declarators (C++26)
- Pack indexing `Ts...[0]` in types and expressions (C++26); `...[` is one token, so a pack
  expansion followed by a subscript is never misread
- Attributes on structured bindings: `auto [a [[maybe_unused]], b]` (C++26)
- Explicit instantiation of a class template: `template class Ring<int, 4>;`
- Attributes before `friend` (as in #366)

New corpus: test/corpus/cpp23-26.txt.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 grammar.js               |  62 +++++++++-
 test/corpus/cpp23-26.txt | 244 +++++++++++++++++++++++++++++++++++++++
 2 files changed, 300 insertions(+), 6 deletions(-)
 create mode 100644 test/corpus/cpp23-26.txt

diff --git a/grammar.js b/grammar.js
index ffbaf0f..723b7b6 100644
--- a/grammar.js
+++ b/grammar.js
@@ -63,6 +63,11 @@ module.exports = grammar(C, {
   ],
 
   conflicts: $ => [
+    [$._declaration_modifiers, $.friend_declaration],
+    [$._declaration_modifiers, $.friend_declaration, $.using_declaration],
+    [$.type_specifier, $._top_level_expression_statement],
+    [$._block_item, $.initializer_list],
+    [$._declaration_modifiers, $._empty_declaration],
     // C
     [$.type_specifier, $._declarator],
     [$.type_specifier, $.expression],
@@ -195,6 +200,7 @@ module.exports = grammar(C, {
       $.enum_specifier,
       $.class_specifier,
       $.sized_type_specifier,
+      alias($.pack_index_expression, $.pack_index_type),
       $.primitive_type,
       $.template_type,
       $.dependent_type,
@@ -430,11 +436,22 @@ module.exports = grammar(C, {
     template_instantiation: $ => prec(1, seq(
       optional('extern'),
       'template',
-      optional($._declaration_specifiers),
-      field('declarator', $._declarator),
+      choice(
+        seq(
+          optional($._declaration_specifiers),
+          field('declarator', $._declarator),
+        ),
+        // `template class Ring<int, 4>;` names a class and declares nothing
+        $._class_name_specifier_for_instantiation,
+      ),
       ';',
     )),
 
+    _class_name_specifier_for_instantiation: $ => seq(
+      choice('class', 'struct', 'union'),
+      field('name', $._class_name),
+    ),
+
     template_parameter_list: $ => seq(
       '<',
       commaSep(choice(
@@ -655,6 +672,7 @@ module.exports = grammar(C, {
     pure_virtual_clause: _ => seq('=', /0/, ';'),
 
     friend_declaration: $ => seq(
+      repeat($.attribute_declaration),
       optional('constexpr'),
       'friend',
       choice(
@@ -710,7 +728,7 @@ module.exports = grammar(C, {
     abstract_reference_declarator: $ => prec.right(seq(choice('&', '&&'), optional($._abstract_declarator))),
 
     structured_binding_declarator: $ => prec.dynamic(PREC.STRUCTURED_BINDING, seq(
-      '[', commaSep1($.identifier), ']',
+      '[', commaSep1(seq($.identifier, repeat($.attribute_declaration))), ']',
     )),
 
     ref_qualifier: _ => choice('&', '&&'),
@@ -746,8 +764,19 @@ module.exports = grammar(C, {
     _function_postfix: $ => prec.right(choice(
       repeat1($.virtual_specifier),
       $.requires_clause,
+      repeat1($.contract_specifier),
     )),
 
+    // C++26 contracts: pre(x > 0), post(r: r > 0)
+    contract_specifier: $ => seq(
+      choice('pre', 'post'),
+      repeat($.attribute_declaration),
+      '(',
+      optional(seq(field('result', $.identifier), ':')),
+      field('condition', $.expression),
+      ')',
+    ),
+
     function_declarator: $ => prec.dynamic(1, seq(
       field('declarator', $._declarator),
       $._function_declarator_seq,
@@ -930,9 +959,19 @@ module.exports = grammar(C, {
 
     if_statement: $ => prec.right(seq(
       'if',
-      optional('constexpr'),
-      field('condition', $.condition_clause),
-      field('consequence', $.statement),
+      choice(
+        seq(
+          optional('constexpr'),
+          field('condition', $.condition_clause),
+          field('consequence', $.statement),
+        ),
+        // C++23: if consteval { … } / if !consteval { … }
+        seq(
+          optional('!'),
+          'consteval',
+          field('consequence', $.compound_statement),
+        ),
+      ),
       optional(field('alternative', $.else_clause)),
     )),
 
@@ -1038,6 +1077,7 @@ module.exports = grammar(C, {
       $.delete_expression,
       $.lambda_expression,
       $.parameter_pack_expansion,
+      $.pack_index_expression,
       $.this,
       $.user_defined_literal,
       $.fold_expression,
@@ -1321,6 +1361,16 @@ module.exports = grammar(C, {
       '...',
     )),
 
+    // C++26 pack indexing: Ts...[0], args...[i]
+    // `...[` is one token: before C++26 it could not appear, so it cannot be mistaken for a pack
+    // expansion followed by a subscript.
+    pack_index_expression: $ => seq(
+      field('pack', $.identifier),
+      alias(token(seq('...', /\s*/, '[')), '...['),
+      field('index', $.expression),
+      ']',
+    ),
+
     type_parameter_pack_expansion: $ => seq(
       field('pattern', $.type_descriptor),
       '...',
diff --git a/test/corpus/cpp23-26.txt b/test/corpus/cpp23-26.txt
new file mode 100644
index 0000000..136274d
--- /dev/null
+++ b/test/corpus/cpp23-26.txt
@@ -0,0 +1,244 @@
+================================================================================
+Deducing this
+================================================================================
+
+struct S { void f(this S const& self) {} };
+
+--------------------------------------------------------------------------------
+
+(translation_unit
+  (struct_specifier
+    (type_identifier)
+    (field_declaration_list
+      (function_definition
+        (primitive_type)
+        (function_declarator
+          (field_identifier)
+          (parameter_list
+            (explicit_object_parameter_declaration
+              (this)
+              (parameter_declaration
+                (type_identifier)
+                (type_qualifier)
+                (reference_declarator
+                  (identifier))))))
+        (compound_statement)))))
+
+================================================================================
+If consteval
+================================================================================
+
+constexpr int f() { if consteval { return 1; } else { return 2; } }
+
+--------------------------------------------------------------------------------
+
+(translation_unit
+  (function_definition
+    (type_qualifier)
+    (primitive_type)
+    (function_declarator
+      (identifier)
+      (parameter_list))
+    (compound_statement
+      (if_statement
+        (compound_statement
+          (return_statement
+            (number_literal)))
+        (else_clause
+          (compound_statement
+            (return_statement
+              (number_literal))))))))
+
+================================================================================
+If not consteval
+================================================================================
+
+constexpr int f() { if !consteval { return 1; } return 2; }
+
+--------------------------------------------------------------------------------
+
+(translation_unit
+  (function_definition
+    (type_qualifier)
+    (primitive_type)
+    (function_declarator
+      (identifier)
+      (parameter_list))
+    (compound_statement
+      (if_statement
+        (compound_statement
+          (return_statement
+            (number_literal))))
+      (return_statement
+        (number_literal)))))
+
+================================================================================
+Pack indexing
+================================================================================
+
+template <typename... Ts> using First = Ts...[0];
+
+--------------------------------------------------------------------------------
+
+(translation_unit
+  (template_declaration
+    (template_parameter_list
+      (variadic_type_parameter_declaration
+        (type_identifier)))
+    (alias_declaration
+      (type_identifier)
+      (type_descriptor
+        (pack_index_type
+          (identifier)
+          (number_literal))))))
+
+================================================================================
+Deleted reason
+================================================================================
+
+void f() = delete("use g");
+
+--------------------------------------------------------------------------------
+
+(translation_unit
+  (declaration
+    (primitive_type)
+    (init_declarator
+      (function_declarator
+        (identifier)
+        (parameter_list))
+      (delete_expression
+        (parenthesized_expression
+          (string_literal
+            (string_content)))))))
+
+================================================================================
+Contracts
+================================================================================
+
+int f(int x) pre(x > 0) post(r: r > 0);
+
+--------------------------------------------------------------------------------
+
+(translation_unit
+  (declaration
+    (primitive_type)
+    (function_declarator
+      (identifier)
+      (parameter_list
+        (parameter_declaration
+          (primitive_type)
+          (identifier)))
+      (contract_specifier
+        (binary_expression
+          (identifier)
+          (number_literal)))
+      (contract_specifier
+        (identifier)
+        (binary_expression
+          (identifier)
+          (number_literal))))))
+
+================================================================================
+Structured binding attr
+================================================================================
+
+auto [a [[maybe_unused]], b] = pair;
+
+--------------------------------------------------------------------------------
+
+(translation_unit
+  (declaration
+    (placeholder_type_specifier
+      (auto))
+    (init_declarator
+      (structured_binding_declarator
+        (identifier)
+        (attribute_declaration
+          (attribute
+            (identifier)))
+        (identifier))
+      (identifier))))
+
+================================================================================
+Named escape
+================================================================================
+
+auto s = "\N{LATIN SMALL LETTER A}";
+
+--------------------------------------------------------------------------------
+
+(translation_unit
+  (declaration
+    (placeholder_type_specifier
+      (auto))
+    (init_declarator
+      (identifier)
+      (string_literal
+        (escape_sequence)))))
+
+================================================================================
+Delimited escape
+================================================================================
+
+auto s = "\x{41}\o{101}\u{1F4E6}";
+
+--------------------------------------------------------------------------------
+
+(translation_unit
+  (declaration
+    (placeholder_type_specifier
+      (auto))
+    (init_declarator
+      (identifier)
+      (string_literal
+        (escape_sequence)
+        (escape_sequence)
+        (escape_sequence)))))
+
+================================================================================
+Explicit instantiation
+================================================================================
+
+template class Ring<int, 4>;
+extern template class Ring<long, 4>;
+
+--------------------------------------------------------------------------------
+
+(translation_unit
+  (template_instantiation
+    (template_type
+      (type_identifier)
+      (template_argument_list
+        (type_descriptor
+          (primitive_type))
+        (number_literal))))
+  (template_instantiation
+    (template_type
+      (type_identifier)
+      (template_argument_list
+        (type_descriptor
+          (sized_type_specifier))
+        (number_literal)))))
+
+================================================================================
+Friend attr
+================================================================================
+
+struct S { [[maybe_unused]] friend void f(); };
+
+--------------------------------------------------------------------------------
+
+(translation_unit
+  (struct_specifier
+    (type_identifier)
+    (field_declaration_list
+      (friend_declaration
+        (attribute_declaration
+          (attribute
+            (identifier)))
+        (declaration
+          (primitive_type)
+          (function_declarator
+            (identifier)
+            (parameter_list)))))))

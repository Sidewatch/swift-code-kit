From 8f98626bc79fb395388b76c0f7c2a1536f88ba77 Mon Sep 17 00:00:00 2001
From: David Michael <22668877+arraypress@users.noreply.github.com>
Date: Fri, 2 Oct 2026 18:11:51 +0700
Subject: [PATCH] Parse Java 25: module imports, flexible constructor bodies,
 and two pattern forms
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- `import module java.base;` (JEP 511)
- Statements before `this(…)` / `super(…)` in a constructor (JEP 513)
- A qualified type in a record pattern: `o instanceof Shapes.Point(var x, var y)` (as in #231)
- `final` on a type pattern: `case final String s ->` (as in #230)

New corpus: test/corpus/java25.txt.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 grammar.js             |  10 ++--
 test/corpus/java25.txt | 127 +++++++++++++++++++++++++++++++++++++++++
 2 files changed, 133 insertions(+), 4 deletions(-)
 create mode 100644 test/corpus/java25.txt

diff --git a/grammar.js b/grammar.js
index a97fd9f..9d4003d 100644
--- a/grammar.js
+++ b/grammar.js
@@ -520,8 +520,8 @@ module.exports = grammar({
       $.type_pattern,
       $.record_pattern,
     ),
-    type_pattern: $ => seq($._unannotated_type, choice($.identifier, $._reserved_identifier)),
-    record_pattern: $ => seq(choice($.identifier, $._reserved_identifier, $.generic_type), $.record_pattern_body),
+    type_pattern: $ => seq(optional('final'), $._unannotated_type, choice($.identifier, $._reserved_identifier)),
+    record_pattern: $ => seq(choice($.identifier, $._reserved_identifier, $.generic_type, $.scoped_type_identifier), $.record_pattern_body),
     record_pattern_body: $ => seq('(', commaSep(choice($.record_pattern_component, $.record_pattern)), ')'),
     record_pattern_component: $ => choice(
       $.underscore_pattern,
@@ -840,7 +840,8 @@ module.exports = grammar({
 
     import_declaration: $ => seq(
       'import',
-      optional('static'),
+      // Java 25: `import module java.base;` (JEP 511)
+      optional(choice('static', 'module')),
       $._name,
       optional(seq('.', $.asterisk)),
       ';',
@@ -976,10 +977,11 @@ module.exports = grammar({
       field('parameters', $.formal_parameters),
     ),
 
+    // Java 25 flexible constructor bodies (JEP 513): statements may come before this(…) / super(…)
     constructor_body: $ => seq(
       '{',
-      optional($.explicit_constructor_invocation),
       repeat($.statement),
+      optional(seq($.explicit_constructor_invocation, repeat($.statement))),
       '}',
     ),
 
diff --git a/test/corpus/java25.txt b/test/corpus/java25.txt
new file mode 100644
index 0000000..897f508
--- /dev/null
+++ b/test/corpus/java25.txt
@@ -0,0 +1,127 @@
+================================================================================
+Record pattern qualified
+================================================================================
+
+class A { void f(Object o) { if (o instanceof Shapes.Point(var x, var y)) {} } }
+
+--------------------------------------------------------------------------------
+
+(program
+  (class_declaration
+    (identifier)
+    (class_body
+      (method_declaration
+        (void_type)
+        (identifier)
+        (formal_parameters
+          (formal_parameter
+            (type_identifier)
+            (identifier)))
+        (block
+          (if_statement
+            (parenthesized_expression
+              (instanceof_expression
+                (identifier)
+                (record_pattern
+                  (scoped_type_identifier
+                    (type_identifier)
+                    (type_identifier))
+                  (record_pattern_body
+                    (record_pattern_component
+                      (type_identifier)
+                      (identifier))
+                    (record_pattern_component
+                      (type_identifier)
+                      (identifier))))))
+            (block)))))))
+
+================================================================================
+Module import
+================================================================================
+
+import module java.base;
+class A {}
+
+--------------------------------------------------------------------------------
+
+(program
+  (import_declaration
+    (scoped_identifier
+      (identifier)
+      (identifier)))
+  (class_declaration
+    (identifier)
+    (class_body)))
+
+================================================================================
+Flexible ctor
+================================================================================
+
+class A extends B { A(int x) { if (x < 0) throw new IllegalArgumentException(); super(x); } }
+
+--------------------------------------------------------------------------------
+
+(program
+  (class_declaration
+    (identifier)
+    (superclass
+      (type_identifier))
+    (class_body
+      (constructor_declaration
+        (identifier)
+        (formal_parameters
+          (formal_parameter
+            (integral_type)
+            (identifier)))
+        (constructor_body
+          (if_statement
+            (parenthesized_expression
+              (binary_expression
+                (identifier)
+                (decimal_integer_literal)))
+            (throw_statement
+              (object_creation_expression
+                (type_identifier)
+                (argument_list))))
+          (explicit_constructor_invocation
+            (super)
+            (argument_list
+              (identifier))))))))
+
+================================================================================
+Switch final type pattern
+================================================================================
+
+class A { int f(Object o) { return switch (o) { case final String s -> 1; default -> 0; }; } }
+
+--------------------------------------------------------------------------------
+
+(program
+  (class_declaration
+    (identifier)
+    (class_body
+      (method_declaration
+        (integral_type)
+        (identifier)
+        (formal_parameters
+          (formal_parameter
+            (type_identifier)
+            (identifier)))
+        (block
+          (return_statement
+            (switch_expression
+              (parenthesized_expression
+                (identifier))
+              (switch_block
+                (switch_rule
+                  (switch_label
+                    (pattern
+                      (type_pattern
+                        (type_identifier)
+                        (identifier))))
+                  (expression_statement
+                    (decimal_integer_literal)))
+                (switch_rule
+                  (switch_label)
+                  (expression_statement
+                    (decimal_integer_literal)))))))))))
-- 

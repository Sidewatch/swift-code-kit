diff --git a/test/corpus/modern.txt b/test/corpus/modern.txt
new file mode 100644
index 0000000..620f8d3
--- /dev/null
+++ b/test/corpus/modern.txt
@@ -0,0 +1,714 @@
+=============================================
+Import layer
+=============================================
+
+@import url("reset.css") layer(base);
+
+---
+
+(stylesheet
+  (import_statement
+    (url_call
+      (function_name)
+      (arguments
+        (string_value
+          (string_content))))
+    (function_name)
+    (layer_name)))
+
+=============================================
+Import layer supports
+=============================================
+
+@import url(unquoted.css) layer(theme) supports(display: grid) screen;
+
+---
+
+(stylesheet
+  (import_statement
+    (url_call
+      (function_name)
+      (arguments
+        (plain_value)))
+    (function_name)
+    (layer_name)
+    (style_query
+      (function_name)
+      (feature_name)
+      (plain_value))
+    (keyword_query)))
+
+=============================================
+Page first
+=============================================
+
+@page :first { margin: 1in; }
+
+---
+
+(stylesheet
+  (page_statement
+    (page_selector)
+    (block
+      (declaration
+        (property_name)
+        (integer_value
+          (unit))))))
+
+=============================================
+Attr flag i
+=============================================
+
+a[href$=".pdf" i] { x: y; }
+
+---
+
+(stylesheet
+  (rule_set
+    (selectors
+      (attribute_selector
+        (tag_name)
+        (attribute_name)
+        (string_value
+          (string_content))
+        (attribute_flag)))
+    (block
+      (declaration
+        (property_name)
+        (plain_value)))))
+
+=============================================
+Attr flag s
+=============================================
+
+a[href^='http' s] { x: y; }
+
+---
+
+(stylesheet
+  (rule_set
+    (selectors
+      (attribute_selector
+        (tag_name)
+        (attribute_name)
+        (string_value
+          (string_content))
+        (attribute_flag)))
+    (block
+      (declaration
+        (property_name)
+        (plain_value)))))
+
+=============================================
+Nest amp after
+=============================================
+
+.a { .dense & { padding: 0; } }
+
+---
+
+(stylesheet
+  (rule_set
+    (selectors
+      (class_selector
+        (class_name
+          (identifier))))
+    (block
+      (rule_set
+        (selectors
+          (descendant_selector
+            (class_selector
+              (class_name
+                (identifier)))
+            (nesting_selector)))
+        (block
+          (declaration
+            (property_name)
+            (integer_value)))))))
+
+=============================================
+Nest media range
+=============================================
+
+.a { @media (width < 600px) { display: block; } }
+
+---
+
+(stylesheet
